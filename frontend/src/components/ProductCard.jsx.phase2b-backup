import { useNavigate } from "react-router-dom";
import { useCart } from "../context/CartContext";

const FALLBACK_IMAGE = "data:image/svg+xml;charset=UTF-8," + encodeURIComponent(`
<svg xmlns="http://www.w3.org/2000/svg" width="600" height="750" viewBox="0 0 600 750">
  <rect width="600" height="750" fill="#f7f1ec"/>
  <rect x="45" y="45" width="510" height="660" rx="24" fill="#fffaf6" stroke="#d7c3b5" stroke-width="4"/>
  <text x="300" y="330" text-anchor="middle" font-family="Arial, sans-serif" font-size="44" fill="#6b2d2d"> AV Silks </text>
  <text x="300" y="390" text-anchor="middle" font-family="Arial, sans-serif" font-size="25" fill="#8b6f63"> Product image coming soon </text>
</svg>
`);

function getProductImage(product) {
  const image = product?.image || product?.imageUrl;
  if (typeof image !== "string") { return FALLBACK_IMAGE; }
  const cleanedImage = image.trim();
  if (!cleanedImage) { return FALLBACK_IMAGE; }
  return cleanedImage;
}

export default function ProductCard({ product }) {
  const navigate = useNavigate();
  const { addToCart } = useCart();
  const productName = product?.name || "AV Silks Saree";
  const productPrice = Number(product?.salePrice || product?.price || 0);

  function handleImageError(event) {
    event.currentTarget.onerror = null;
    event.currentTarget.src = FALLBACK_IMAGE;
  }

  function handleOpenProduct() {
    if (product?.id) { navigate(`/product/${product.id}`); }
  }

  function handleAddToCart(event) {
    event.stopPropagation();
    addToCart(product);
  }

  return (
    <article onClick={handleOpenProduct} style={{ background: "#ffffff", borderRadius: "12px", overflow: "hidden", boxShadow: "0 3px 12px rgba(0,0,0,0.10)", border: "1px solid #eee5df", cursor: product?.id ? "pointer" : "default", display: "flex", flexDirection: "column", minHeight: "100%" }}>
      <div style={{ width: "100%", aspectRatio: "4 / 5", background: "#f7f2ef", overflow: "hidden" }}>
        <img src={getProductImage(product)} alt={productName} onError={handleImageError} loading="lazy" style={{ width: "100%", height: "100%", display: "block", objectFit: "cover" }} />
      </div>
      <div style={{ padding: "12px", display: "flex", flexDirection: "column", flex: 1 }}>
        <h3 style={{ margin: "0 0 8px", fontSize: "15px", lineHeight: 1.35, color: "#2c1b17", minHeight: "40px" }}> {productName} </h3>
        <p style={{ margin: "0 0 12px", fontSize: "16px", fontWeight: 700, color: "#6b2525" }}> ₹{productPrice.toLocaleString("en-IN")} </p>
        <button type="button" onClick={handleAddToCart} disabled={!product?.id} style={{ width: "100%", marginTop: "auto", padding: "11px 10px", border: "none", borderRadius: "7px", background: product?.id ? "#a33a2b" : "#bdbdbd", color: "#ffffff", fontSize: "14px", fontWeight: 700, cursor: product?.id ? "pointer" : "not-allowed" }}> Add to Cart </button>
      </div>
    </article>
  );
}
